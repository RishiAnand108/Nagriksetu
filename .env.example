# ── Copy to .env and fill in. Never commit the real .env. ──────────────
#
# Settings module: dev | prod. If unset, dev is used only when DEBUG=True;
# otherwise production settings load and refuse to start without a real
# SECRET_KEY and explicit ALLOWED_HOSTS (fail closed).
DJANGO_ENV=dev
DEBUG=True

# Required for prod / docker compose. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1
# Behind HTTPS (Render, nginx, …):
# CSRF_TRUSTED_ORIGINS=https://nagriksetu.onrender.com
# Absolute links in emails.
SITE_URL=http://localhost:8000

# Database. Defaults to the local SQLite file when unset.
# DATABASE_URL=postgres://user:pass@host:5432/nagriksetu

# ── Background jobs & cache (optional) ────────────────────────────────
# Unset = image processing and emails run inline in the request.
# CELERY_BROKER_URL=redis://localhost:6379/0
# Shared cache for rate limits across workers.
# REDIS_URL=redis://localhost:6379/1

# ── Media storage (S3-compatible: AWS S3, Cloudflare R2, MinIO) ──────────
# Unset = uploads go to ./media on local disk.
# AWS_STORAGE_BUCKET_NAME=nagriksetu-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com   # R2 / MinIO only
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=media.example.com   # public bucket domain; enables unsigned URLs
# Single-instance demos without object storage only (files are lost on redeploy):
# SERVE_MEDIA_FROM_APP=True

# ── Email ───────────────────────────────────────────────────────────
# Unset = printed to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=NagrikSetu <noreply@example.com>

# ── API clients on another origin ────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://app.example.com

# ── Tuning ──────────────────────────────────────────────────────────
# MAX_UPLOAD_SIZE_MB=8
# IMAGE_MAX_PIXELS=40000000
# IMAGE_MAX_WIDTH=1600
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7
# THROTTLE_LOGIN=10/min
# LOG_LEVEL=INFO
